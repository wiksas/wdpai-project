APP_PORT=8080
POSTGRES_PORT=5433
POSTGRES_DB=wdpai_db
POSTGRES_USER=wdpai_user
POSTGRES_PASSWORD=wdpai_password
MAILPIT_PORT=8025
PGADMIN_CONTAINER_NAME=pg-admin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
APP_URL=http://localhost:8080
MAIL_FROM=no-reply@komorebi.local
# Ollama na innym komputerze (np. z kartą graficzną); bez tej linii usługa `ollama` z docker-compose.yaml.
# OLLAMA_URL=http://100.73.95.84:11434
VISION_MODEL=qwen2.5vl:7b
CHAT_MODEL=gemma3:4b
# Tylko na komputerze z kartą NVIDIA: Ollama na GPU (bez tych linii liczy na procesorze).
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml